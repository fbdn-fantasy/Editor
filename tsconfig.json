{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "allowJs": true, "checkJs": false,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "*.ts"]
}
